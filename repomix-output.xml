            <p className="text-xs font-mono font-bold text-zinc-200">{money(sales.paymentSplit.mpesa)}</p>
          </div>
          <div className="flex-1 bg-zinc-900/40 border border-zinc-800/60 rounded-lg p-2 text-center">
